# ==============================================================================
# Alfi Kitchen — Contoh Konfigurasi Lingkungan (.env)
# ==============================================================================
# Petunjuk:
# 1. Salin file ini menjadi ".env": cp .env.example .env
# 2. Sesuaikan kredensial di bawah ini dengan database lokal / hosting Anda.
# 3. File ".env" sudah masuk dalam .gitignore sehingga TIDAK akan ter-commit ke Git.
# ==============================================================================

# Kredensial Database
DB_HOST=localhost
DB_NAME=alfi_kitchen
DB_USER=root
DB_PASS=

# Konfigurasi Aplikasi & Domain
# Lokal       : http://localhost/Alfi_Kitchen
# InfinityFree: https://kitchen.pojokberkah.online
SITE_URL=http://localhost/Alfi_Kitchen

# Lingkungan & Debugging (local / production)
APP_ENV=local
APP_DEBUG=true
