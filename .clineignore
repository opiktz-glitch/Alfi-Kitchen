# ============================================================================
# .clineignore – Alfi Kitchen
# File dan folder yang diabaikan oleh Cline saat membaca codebase.
# Ikuti pola sintaks .gitignore.
# ============================================================================

# --- Kredensial & konfigurasi sensitif (JANGAN dibaca Cline) ---
.env
config.php

# --- File log runtime ---
/logs/*
!/logs/.htaccess

# --- Folder uploads (gambar pengguna, bukan source code) ---
/uploads/*
!/uploads/.gitkeep
!/uploads/.htaccess

# --- File sistem operasi ---
.DS_Store
Thumbs.db
desktop.ini

# --- Editor / IDE ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- Version control & CI ---
.git/
.gitignore
.github/

# --- File database (dump & migrasi SQL) ---
/database/*.sql

# --- Aset statis / biner (gambar, ikon, font, dll.) ---
*.jpg
*.jpeg
*.png
*.gif
*.ico
*.svg
*.webp
*.bmp
*.woff
*.woff2
*.ttf
*.eot

# --- File cadangan / sementara / cache ---
*.bak
*.tmp
*.cache
*.php~
*.sql~
*.log

# ============================================================================
# Catatan:
# - README.md dan database/SCHEMA.md SENGAJA tidak diabaikan agar Cline
#   masih dapat memahami dokumentasi project dan skema basis data.
# - File PHP utama (index.php, admin/*.php, views/*.php, dll.)
#   tetap dibaca kecuali yang tercantum di atas.
# - config.php SENGAJA diabaikan karena berisi kredensial sensitif.
# ============================================================================