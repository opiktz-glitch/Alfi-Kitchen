# Alfi Kitchen — .htaccess production
# Domain baku: https://kitchen.pojokberkah.online (tanpa www)
<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Paksa HTTPS (aman: cek X-Forwarded-Proto utk proxy/CDN InfinityFree)
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # 2. Buang www (samakan ke non-www sesuai domain baku)
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

    # 3. index.php -> / (hindari duplikat homepage)
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.php[?\s] [NC]
    RewriteRule ^index\.php$ / [R=301,L]

    # Produk URL ramah SEO: /produk/nama-produk
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^produk/([^/]+)/?$ product.php?slug=$1 [L,QSA]

    # Tanpa trailing slash ganda (hindari URL ganda)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.+)//$ /$1 [R=301,L]

    # SEO: robots.txt & sitemap.xml dibuat dinamis (mengikuti domain yang dipakai)
    RewriteRule ^robots\.txt$ robots.php [L]
    RewriteRule ^sitemap\.xml$ sitemap.php [L]
</IfModule>

# Matikan directory listing (keamanan + SEO: jangan biarkan /uploads terindeks)
Options -Indexes

# Lindungi file sensitif dari akses HTTP langsung (kompatibel Apache 2.2 & 2.4)
<FilesMatch "(\.(sql|log|ini|env|gitignore|clineignore)|phpunit\.xml)$">
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>

# ============================================================================
# SEO Modern: Hindari indeksasi area admin & sistem lewat X-Robots-Tag
# Pendekatan ini direkomendasikan Google alih-alih Disallow di robots.txt,
# karena Disallow hanya mencegah crawling, TIDAK mencegah indeksasi jika
# URL tersebut ditemukan dari link eksternal.
# ============================================================================
<IfModule mod_setenvif.c>
    SetEnvIf Request_URI "(^|/)(admin/|login\.php|logs/|database/)" NOINDEX
</IfModule>

<IfModule mod_headers.c>
    Header set X-Robots-Tag "noindex, nofollow" env=NOINDEX

    # HTTP Security Headers (Proteksi Browser Modern)
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ============================================================================
# Halaman Error Ramah Pengunjung (Custom 404)
# ============================================================================
ErrorDocument 404 404.php

# ============================================================================
# Browser Caching & Kompresi Aset Statis
# Menghemat CPU & bandwidth InfinityFree serta mempercepat akses berulang
# ============================================================================
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 2 days"

    # Gambar & Aset Visual (1 Bulan)
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 year"

    # CSS & JavaScript (1 Minggu)
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType text/javascript "access plus 1 week"

    # Font (1 Bulan)
    ExpiresByType font/ttf "access plus 1 month"
    ExpiresByType font/woff "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 month"

    # Web App Manifest PWA (1 Minggu)
    ExpiresByType application/manifest+json "access plus 1 week"
</IfModule>

<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(ico|jpe?g|png|gif|webp|svg|css|js|woff2?|webmanifest)$">
        Header set Cache-Control "max-age=2592000, public"
    </FilesMatch>
</IfModule>

